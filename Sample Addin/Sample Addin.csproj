<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net8.0-windows</TargetFramework>
		<UseWindowsForms>true</UseWindowsForms>
		<OutputType>Library</OutputType>
		<RootNamespace>InventorRibbonTest</RootNamespace>
		<AssemblyName>InventorRibbonTest</AssemblyName>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="..\InventorRibbonManager\InventorRibbonManager.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="Inventor">
			<HintPath>C:\Program Files\Autodesk\Inventor 2025\Bin\Autodesk.Inventor.Interop.dll</HintPath>
		</Reference>
		<Reference Include="stdole">
			<HintPath>C:\Program Files\Autodesk\Inventor 2025\Bin\stdole.dll</HintPath>
		</Reference>
	</ItemGroup>


	<ItemGroup>
		<None Update="InventorRibbonTest.addin">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Properties\1-16x16.png">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Properties\1-32x32.png">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Properties\2-16x16.png">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Properties\2-32x32.png">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Properties\3-16x16.png">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Properties\3-32x32.png">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Properties\4-16x16.png">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Properties\4-32x32.png">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Properties\5-16x16.png">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Properties\5-32x32.png">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>


	<ItemGroup>
	  <Folder Include="docs\" />
	</ItemGroup>

	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
		<Exec Command="xcopy /Y &quot;$(TargetDir)InventorRibbonTest.addin&quot; &quot;%25ALLUSERSPROFILE%25\Autodesk\Inventor Addins\&quot;&#xD;&#xA;if not exist &quot;C:\temp\InventorRibbonTest&quot; mkdir &quot;C:\temp\InventorRibbonTest&quot;&#xD;&#xA;xcopy /Y /E /I &quot;$(TargetDir)*&quot; &quot;C:\temp\InventorRibbonTest\&quot;" />
	</Target>
</Project>
